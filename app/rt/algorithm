#pragma once
// Minimal <algorithm> for bare-metal builds.
namespace std {
template <class T> inline const T& min(const T& a, const T& b) { return b < a ? b : a; }
template <class T> inline const T& max(const T& a, const T& b) { return a < b ? b : a; }
template <class T> inline void swap(T& a, T& b) { T t = a; a = b; b = t; }
template <class It, class T> inline void fill(It first, It last, const T& v) { for (; first != last; ++first) *first = v; }
template <class I, class O> inline O copy(I first, I last, O d) { for (; first != last; ++first, ++d) *d = *first; return d; }
template <class It> inline void sort(It first, It last) {
  for (It i = first; i != last; ++i)
    for (It j = i; j != first && *j < *(j - 1); --j) swap(*j, *(j - 1));
}
template <class It, class T> inline It lower_bound(It first, It last, const T& v) {
  long n = last - first;
  while (n > 0) { long h = n / 2; It m = first + h; if (*m < v) { first = m + 1; n -= h + 1; } else n = h; }
  return first;
}
template <class It, class T> inline It upper_bound(It first, It last, const T& v) {
  long n = last - first;
  while (n > 0) { long h = n / 2; It m = first + h; if (!(v < *m)) { first = m + 1; n -= h + 1; } else n = h; }
  return first;
}
}
