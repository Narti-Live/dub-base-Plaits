 #include "stmlib/system/storage.h"
 
 #include "plaits/drivers/cv_adc.h"
@@ -81,6 +83,20 @@ class Settings {
     return &persistent_data_.channel_calibration_data[channel];
   }
 
+  // AUX pitch CV scale (CV TUNE), stored in the calibration data padding.
+  inline bool cv_scale(float* scale) const {
+    uint32_t tag;
+    memcpy(&tag, &persistent_data_.padding[4], 4);
+    if (tag != 0x43534356) return false;  // 'VCSC'
+    memcpy(scale, &persistent_data_.padding[0], 4);
+    return *scale > 1000.0f && *scale < 30000.0f;
+  }
+  inline void set_cv_scale(float scale) {
+    uint32_t tag = 0x43534356;
+    memcpy(&persistent_data_.padding[0], &scale, 4);
+    memcpy(&persistent_data_.padding[4], &tag, 4);
+  }
+
   inline const State& state() const {
     return state_;
   }
